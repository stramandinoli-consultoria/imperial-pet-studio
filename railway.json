{
  "schema": 2,
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm --omit=dev run build"
  },
  "deploy": {
    "startCommand": "npx vite preview --host 0.0.0.0 --port ${PORT}",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "domains": {
    "primary": "imperialpets.com.br",
    "redirects": {
      "www.imperialpets.com.br": "imperialpets.com.br"
    }
  }
}
